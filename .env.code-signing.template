# CircuitExp1 Code Signing Environment Configuration Template
# Copy this file to .env.local and fill in your actual values
# NEVER commit the actual .env.local file to version control

# =============================================================================
# WINDOWS CODE SIGNING (EV Certificate)
# =============================================================================

# Windows EV Certificate (from USB token or cloud HSM)
# For USB token: path to certificate file
# For cloud HSM: certificate thumbprint or identifier
WINDOWS_CERTIFICATE_FILE=path/to/your/certificate.p12
WINDOWS_CERTIFICATE_THUMBPRINT=your_certificate_thumbprint_here

# Certificate password (store securely, use CI/CD secrets in production)
WINDOWS_CERTIFICATE_PASSWORD=your_certificate_password

# Timestamp server for Windows signing
WINDOWS_TIMESTAMP_URL=http://timestamp.digicert.com

# Code signing tool path (optional, auto-detected if not specified)
WINDOWS_SIGNTOOL_PATH=C:\Program Files (x86)\Windows Kits\10\bin\x64\signtool.exe

# =============================================================================
# MACOS CODE SIGNING (Apple Developer)
# =============================================================================

# Apple Developer Certificate (Developer ID Application)
# This should be the certificate name as it appears in Keychain
APPLE_CERTIFICATE_NAME=Developer ID Application: Your Name (TEAM_ID)

# Apple Team ID (found in Apple Developer account)
APPLE_TEAM_ID=YOUR_TEAM_ID

# Apple ID for notarization
APPLE_ID=your.apple.id@example.com

# App-specific password for notarization (not your Apple ID password!)
# Generate this in your Apple ID account settings
APPLE_APP_SPECIFIC_PASSWORD=your_app_specific_password

# Keychain profile name (optional, for storing notarization credentials)
APPLE_KEYCHAIN_PROFILE=CircuitExp1_Notarization

# =============================================================================
# LINUX CODE SIGNING (GPG)
# =============================================================================

# GPG key ID for signing (use gpg --list-secret-keys to find)
GPG_KEY_ID=your_gpg_key_id

# GPG key passphrase
GPG_PASSPHRASE=your_gpg_passphrase

# GPG private key (base64 encoded for CI/CD)
# Generate with: gpg --armor --export-secret-keys YOUR_KEY_ID | base64 -w 0
GPG_PRIVATE_KEY_BASE64=your_base64_encoded_private_key

# GPG public key (base64 encoded)
# Generate with: gpg --armor --export YOUR_KEY_ID | base64 -w 0
GPG_PUBLIC_KEY_BASE64=your_base64_encoded_public_key

# =============================================================================
# GENERAL CONFIGURATION
# =============================================================================

# Enable/disable code signing (useful for development)
CODE_SIGNING_ENABLED=true

# Skip code signing verification (for testing)
SKIP_CODE_SIGNING_VERIFICATION=false

# Verbose logging for debugging
CODE_SIGNING_VERBOSE=false

# =============================================================================
# CI/CD SPECIFIC SETTINGS
# =============================================================================

# GitHub Actions
GITHUB_TOKEN=your_github_token_for_releases

# Build environment
BUILD_ENVIRONMENT=production

# Release channel
RELEASE_CHANNEL=stable

# =============================================================================
# SECURITY NOTES
# =============================================================================

# 1. NEVER commit this file with real values to version control
# 2. Use your CI/CD platform's secret management for production
# 3. Rotate certificates and passwords regularly
# 4. Use hardware security modules (HSM) for production certificates
# 5. Enable two-factor authentication on all developer accounts
# 6. Regularly audit access to signing certificates

# =============================================================================
# CERTIFICATE ACQUISITION GUIDE
# =============================================================================

# Windows EV Certificate:
# - Purchase from: DigiCert, Sectigo, GlobalSign, or other CA
# - Requires business verification
# - Delivered via USB token or cloud HSM
# - Cost: $300-500/year

# Apple Developer Certificate:
# - Requires Apple Developer Program membership ($99/year)
# - Generate in Apple Developer portal
# - Download and install in Keychain Access
# - Enable two-factor authentication

# GPG Key:
# - Generate with: gpg --full-generate-key
# - Use RSA, 4096 bits, no expiration (or long expiration)
# - Upload public key to keyservers
# - Backup private key securely

# =============================================================================
# TROUBLESHOOTING
# =============================================================================

# Common issues:
# 1. Certificate not found: Check certificate installation and names
# 2. Permission denied: Run with appropriate privileges
# 3. Network timeouts: Check firewall and proxy settings
# 4. Invalid signatures: Verify certificate validity and chain
# 5. Notarization fails: Check Apple ID credentials and app-specific password

# Debug commands:
# Windows: signtool verify /pa /v your_file.exe
# macOS: codesign -dv --verbose=4 your_app.app
# Linux: gpg --verify your_file.sig your_file
